{
  "name": "guarded-computer-use-mcp",
  "version": "0.2.0",
  "description": "Windows computer-use MCP server with a human-in-the-loop approval gate. Screenshot, mouse, keyboard, UI Automation and OCR — and every risky action waits for a real human click.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "guarded-computer-use-mcp": "server.js"
  },
  "files": [
    "src",
    "test",
    "e2e",
    "server.js",
    "host.ps1",
    "ocr.ps1",
    "ocr_rapid.py",
    "approval.ps1",
    "approval-toggle.ps1",
    "toggle-approval.cmd",
    "guard-panel.ps1",
    "guard-panel.cmd",
    "policy.json",
    "test-policy.mjs",
    "test-typing.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node test-client.js read",
    "test:uia": "node test-client.js uia",
    "test:policy": "node test-policy.mjs",
    "test:typing": "node test-typing.mjs",
    "bench": "node bench.js 5",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:unit": "node --test test/guard.test.mjs test/guard-warning.test.mjs test/audit.test.mjs test/audit-tamper.test.mjs test/policy.test.mjs test/hardening.test.mjs test/approval-lock.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:inject": "node e2e/approval-inject.mjs",
    "test:lock": "node e2e/gate-lock-e2e.mjs",
    "audit:verify": "node src/audit.js verify",
    "guard": "node src/guard.js list",
    "verify": "npm run lint && npm run format:check && npm run test:unit && npm run test:policy && npm run test:smoke && npm run audit:verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "computer-use",
    "windows",
    "desktop-automation",
    "ui-automation",
    "uiautomation",
    "ocr",
    "ai-agent",
    "human-in-the-loop",
    "safety"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/be1st6666/guarded-computer-use-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/be1st6666/guarded-computer-use-mcp/issues"
  },
  "homepage": "https://github.com/be1st6666/guarded-computer-use-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
